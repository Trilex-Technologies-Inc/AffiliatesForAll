function daterange_tabs($name, $download_required) { ?>
<div id="query">
  <form method="post" class="admin-query-form date-range-form">
    <div class="date-range-header">
      <h2><?php echo __('Date Range') ?></h2>
      <p>
        <?php 
          $dis = 'View '. $name .' from:';
          echo __($dis);
        ?>
      </p>
    </div>
    <div class="date-range-grid">
      <div>
        <label class="form-label" for="from"><?php echo __('From') ?></label>
        <input id="from" class="form-control" type="date"/>
      </div>
      <div>
        <label class="form-label" for="to"><?php echo __('To') ?></label>
        <input id="to" class="form-control" type="date"/>
      </div>
    </div>
    <div class="date-range-actions">
      <input id="display" class="btn btn-primary" type="submit" value="<?php echo __('Display') ?>"/>
      <?php if($download_required) { ?>
        <input id="download" class="btn btn-secondary" type="submit" value="<?php echo __('Download') ?>"/>
      <?php } ?>
    </div>
  </form>
</div>
<div id="results">
  <div class="results-card">
    <div class="results-table-wrap">
      <table id="restable" class="table table-striped table-bordered table-hover align-middle">
      </table>
    </div>
    <div id="navigation" class="results-navigation">
      <span class="page-status"><?php echo __('Page') ?> <span id="currentpage">?</span> <?php echo __('of') ?> <span id="maxpages">?</span></span>
      <span class="page-actions">
        <a id="previous" class="btn btn-outline-primary btn-sm" href="#"><?php echo __('Previous Page') ?></a>
        <a id="next" class="btn btn-outline-primary btn-sm" href="#"><?php echo __('Next Page') ?></a>
      </span>
      <span class="page-list"><?php echo __('Page') ?> <span id="pagelist">?</span></span>
    </div>
  </div>
</div>
<?php }

